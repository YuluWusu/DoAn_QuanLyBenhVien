<UserControl x:Class="DoAn_QuanLyBenhVien.Views.UC_ThongKe"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             xmlns:vm="clr-namespace:DoAn_QuanLyBenhVien.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="1100" Background="#0F1923">
    <UserControl.DataContext>
        <vm:VM_ThongKe/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#1A2E45"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="10"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="10,0,0,15" Orientation="Horizontal">
            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Foreground="#00C2A8" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="THỐNG KÊ DOANH THU &amp; DỊCH VỤ" Foreground="White" FontSize="20" FontWeight="Bold"/>
        </StackPanel>

        <!-- KPI Cards -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Tổng Bệnh Nhân" Foreground="#6B8299" FontSize="14"/>
                    <TextBlock Text="{Binding TotalPatients}" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Tổng Doanh Thu (VNĐ)" Foreground="#6B8299" FontSize="14"/>
                    <TextBlock Text="{Binding TotalRevenue, StringFormat={}{0:N0}}" Foreground="#10B981" FontSize="28" FontWeight="Bold" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Button Content="📥  Xuất Báo Cáo Excel" Command="{Binding ExportExcelCommand}" 
                            Background="#00C2A8" Foreground="White" FontWeight="Bold" Padding="15,10" 
                            BorderThickness="0" Cursor="Hand"/>
                    <TextBlock Text="Xuất danh sách Hóa Đơn ra file .xlsx" Foreground="#6B8299" FontSize="11" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Charts -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>

            <!-- Bar Chart -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="DOANH THU THEO THÁNG" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,15"/>
                    <lvc:CartesianChart Grid.Row="1" Series="{Binding RevenueSeries}">
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Title="Tháng" Labels="{Binding RevenueLabels}">
                                <lvc:Axis.Separator>
                                    <lvc:Separator Step="1"/>
                                </lvc:Axis.Separator>
                            </lvc:Axis>
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis Title="VNĐ" LabelFormatter="{Binding Formatter}"/>
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </Grid>
            </Border>

            <!-- Pie Chart -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="TOP 5 DỊCH VỤ PHỔ BIẾN" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,15"/>
                    <lvc:PieChart Grid.Row="1" Series="{Binding ServiceRatioSeries}" LegendLocation="Right" InnerRadius="40" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
